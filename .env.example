PORT=10000
NODE_ENV=development

# Thông tin cá nhân hóa - không phải secret
STUDENT_NAME=Đặng Kiều Trang
STUDENT_ID=23IT279

# Secret dùng để ký session cookie. Không commit giá trị thật.
SESSION_SECRET=replace-with-a-long-random-secret

# Mỗi URI dùng đúng DB user tương ứng trên MongoDB Atlas.
# Không đặt URI thật trong source code.
MONGO_READ_URI=mongodb+srv://READ_USER:PASSWORD@CLUSTER.mongodb.net/DB_23IT279?retryWrites=true&w=majority
MONGO_WRITE_URI=mongodb+srv://WRITE_USER:PASSWORD@CLUSTER.mongodb.net/DB_23IT279?retryWrites=true&w=majority
MONGO_SESSION_URI=mongodb+srv://SESSION_USER:PASSWORD@CLUSTER.mongodb.net/DB_23IT279?retryWrites=true&w=majority

MONGO_MAX_POOL_SIZE=20
